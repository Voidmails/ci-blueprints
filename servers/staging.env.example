# Copy to /opt/voidmails/staging.env on the server. No secrets in this file:
# put runtime secrets in /opt/voidmails/env/staging/<service>.env instead.
ENV_NAME=staging
# no profiles: Caddy runs in the production project, mail is production-only
COMPOSE_PROFILES=
BASE_DOMAIN=example.com
ACME_EMAIL=ops@example.com

# Managed by deploy.sh: one <SERVICE>_TAG line per service.
FRONTEND_TAG=latest
LANDING_TAG=latest
BACKEND_TAG=latest
