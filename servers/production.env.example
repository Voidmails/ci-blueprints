# Copy to /opt/voidmails/production.env on the server. No secrets in this file:
# put runtime secrets in /opt/voidmails/env/production/<service>.env instead.
ENV_NAME=production
# production runs the shared Caddy edge proxy and the mailserver
COMPOSE_PROFILES=edge,mail
BASE_DOMAIN=example.com
ACME_EMAIL=ops@example.com

# Managed by deploy.sh: one <SERVICE>_TAG line per service.
FRONTEND_TAG=latest
LANDING_TAG=latest
BACKEND_TAG=latest
MAILSERVER_TAG=latest
